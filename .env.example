# --- Free LLM (Google Gemini free tier, key from aistudio.google.com) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Instagram Graph API (free; Business/Creator account) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_VERSION=v21.0

# --- Free image hosting: a PUBLIC GitHub repo ---
UPLOADER=github
GITHUB_REPOSITORY=yourname/ig-autopilot
GH_TOKEN=
REPO_BRANCH=main

# --- Brand ---
IG_HANDLE=@abhijeetkumar.founder
BRAND_VOICE=Founder-led, sharp and practical, no hype. Explains what happened and why it matters to founders and operators.
NICHES=AI,business

# --- Behaviour ---
# false = save drafts to ./output for review. true = fully automatic posting.
AUTO_POST=false
POST_TIMES=09:00,19:00
MAX_POSTS_PER_DAY=2
